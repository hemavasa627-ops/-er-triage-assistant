# ER TRIAGE ASSISTANT - Environment Variables Configuration

# Optional Live LLM Integration (OpenAI or compatible endpoint)
# If omitted or left empty, the application runs in offline demo mode using the built-in Heuristic NLP Engine.
LLM_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-3.5-turbo
LLM_PROVIDER=heuristic_fallback

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./backend/triage.db
